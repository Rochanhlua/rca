# Phase 6.4 — SGD optimizer on CPU tensors.
# w_new = w - lr * grad

# Float lr: [1.0, 2.0] - 0.1 * [0.5, 1.0] = [0.95, 1.9]
print(sgd(Tensor([1.0, 2.0]), Tensor([0.5, 1.0]), 0.1))

# Int lr is coerced: subtract full gradient
print(sgd(Tensor([1.0, 2.0]), Tensor([0.5, 1.0]), 1))

# Zero gradient: weights unchanged
print(sgd(Tensor([[1.0, 2.0]]), Tensor([[0.0, 0.0]]), 0.5))

# Composed with autodiff: grad(w*w) = 2*w = 4 at w=2, so w_new = 2 - 0.1*4
let w = track(Tensor([2.0]))
let loss = w * w
let g = grad(loss, w)
print(sgd(Tensor([2.0]), g, 0.1))
